# Required for live voice, audio transcription, and model-generated notes.
# Without it the app falls back to local demo behavior for text flows.
OPENAI_API_KEY=

# Models (defaults shown). Override if you have access to different snapshots.
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
