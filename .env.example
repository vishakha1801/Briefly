# Required for live transcription, voice, and the best sentiment/summary quality.
# Without it the app runs in a fully-functional demo mode (simulated call +
# heuristic sentiment/summary), so you can try the whole flow with no key.
OPENAI_API_KEY=

# Models (defaults shown). Override if you have access to different snapshots.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
